    <Content Include="Assets\SawProjectile.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\RatProjectile.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\ElementalEffects.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\BloodSupplyTruck.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="Assets\BloodSaleFunnel.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <!-- Runtime art is deliberately loose beside the single-file executable.
       GameRenderer loads it from AppContext.BaseDirectory/Assets, so allowing
       single-file publish to bundle these files produces an empty Assets folder
       and silently activates fallback drawings. -->
  <ItemGroup>
    <Content Update="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="VerifyPublishedBlobForgeAssets" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)Assets\FactoryTileset.png')"
           Text="Published BlobForge build is missing Assets\FactoryTileset.png." />
    <Error Condition="!Exists('$(PublishDir)Assets\FactoryBackdropTileset.png')"
           Text="Published BlobForge build is missing Assets\FactoryBackdropTileset.png." />
    <Error Condition="!Exists('$(PublishDir)Assets\ButcherCleaver.png')"
           Text="Published BlobForge build is missing Assets\ButcherCleaver.png." />
    <Error Condition="!Exists('$(PublishDir)Assets\TestArsenalTools.png')"
           Text="Published BlobForge build is missing Assets\TestArsenalTools.png." />
    <Error Condition="!Exists('$(PublishDir)Assets\ElementalEffects.png')"
           Text="Published BlobForge build is missing Assets\ElementalEffects.png." />
  </Target>
</Project>
